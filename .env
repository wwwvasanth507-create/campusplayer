# ============================================================
# CampusPlayer - Environment Configuration (ACTIVE, LOCAL FILE)
# ============================================================
# This is a real, ready-to-use .env — NOT the .env.example template.
# Keep it private: never commit it or upload it anywhere public.
# The values below were freshly generated for this deployment.
# If you ever need new secrets, regenerate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---- Flask (read by app.py) ----
SECRET_KEY=u7aWsBEK9N4I2HwYjvCbeCOcZfVRox4agV7QoIRATxnxZMm2RtTmMMTOaPfDbp1V
# Used by crypto_helper.py to encrypt sensitive stored values (e.g. saved
# passwords for SMS/parent-alert features). Falls back to SECRET_KEY if unset,
# but it's set explicitly here so encrypted data survives a SECRET_KEY rotation.
ENCRYPTION_KEY=-xrMMAcUnly3KZiL37OrbEx3rYq3VUZ8vCO8ToPI5r0=

# Keep False for local/dev use. MUST be False in any environment reachable
# by untrusted users (enables the interactive Werkzeug debugger = RCE risk).
FLASK_DEBUG=False

# Set True only once the app sits behind TLS (nginx/load balancer) and you
# want plain HTTP requests redirected to HTTPS.
FORCE_HTTPS=False

# Set True once you are actually serving over HTTPS so session/remember
# cookies get the Secure flag. Leave False for local http://localhost testing.
SESSION_COOKIE_SECURE=False

# How long a login session stays valid before requiring re-login.
SESSION_TIMEOUT_HOURS=2

# Comma-separated list of origins allowed to fetch HLS video/subtitle
# segments cross-origin with credentials. Leave empty for same-origin only,
# e.g.: MEDIA_ALLOWED_ORIGINS=https://your-frontend.example.com
MEDIA_ALLOWED_ORIGINS=

# ---- Database ----
# SQLite is fine for local/single-server use. For production with multiple
# workers, switch to PostgreSQL, e.g.:
#   DATABASE_URL=postgresql://user:password@localhost/campusplayer
DATABASE_URL=sqlite:///app.db

# ---- Celery (only needed if you actually run a Celery worker) ----
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- First-run admin account ----
# Used the first time the app creates a system admin user. Change this
# password after first login. If left blank, a random one is generated
# and printed once to the server log/console on first startup.
ADMIN_PASSWORD=DqPCTLB7j2ZxXCRd

# ============================================================
# The variables below are NOT currently read by app.py (verified by
# scanning every os.getenv/os.environ call in this codebase). They're kept
# here, disabled/blank, as forward-compatible placeholders in case you wire
# up email/SMS/Gemini features later — they will simply be ignored until
# code is added to read them. This avoids the previous .env.example's
# "SESSION_TIMEOUT_MINUTES" (a name the app never reads — the real one is
# SESSION_TIMEOUT_HOURS above).
# ============================================================
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=noreply@campusplayer.com
# ADMIN_EMAIL=admin@campusplayer.com
# GEMINI_API_KEY=
# SMS_ENABLED=False
