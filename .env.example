# ============================================================
# CampusPlayer - Environment Configuration
# ============================================================
# Copy this file to `.env` and fill in real values before running.
# Keep your `.env` private - don't share it or upload it anywhere public.

# ---- Flask ----
# Generate a strong random value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=
# Used to encrypt sensitive stored values (e.g. via crypto_helper.py).
# If unset, it is derived from SECRET_KEY. Set explicitly in production.
# IMPORTANT: Must be a valid Fernet key (exactly 32 url-safe base64-encoded
# bytes), NOT a random token_urlsafe string. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Enables the Flask/Werkzeug debug reloader and interactive debugger.
# MUST be False (or unset) in any environment reachable by untrusted users.
FLASK_DEBUG=False
# Set True only if the app sits behind TLS termination (nginx/load balancer)
# and you want HTTP requests redirected to HTTPS.
FORCE_HTTPS=False
# Set True once you are serving over HTTPS so session/remember cookies
# are marked Secure.
SESSION_COOKIE_SECURE=False

# Comma-separated list of origins allowed to fetch HLS video/subtitle
# segments cross-origin with credentials. Leave empty for same-origin only.
MEDIA_ALLOWED_ORIGINS=

# ---- Database ----
# Primary Production Database (PostgreSQL):
DATABASE_URL=postgresql://campususer:campuspass@localhost:5432/campusplayer_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Local Development Fallback (SQLite):
# DATABASE_URL=sqlite:///app.db

# ---- Redis (caching & Celery) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ---- Video Processing & Parallel Conversion ----
MAX_VIDEO_SIZE_MB=20480
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
MAX_CONCURRENT_CONVERSIONS=3
MAX_CONVERSION_RETRIES=3
CONVERSION_PROGRESS_INTERVAL=3
CONVERSION_SEGMENT_DURATION=6
FFMPEG_PRESET=ultrafast

# ---- Session ----
# NOTE: app.py reads SESSION_TIMEOUT_HOURS (not *_MINUTES).
SESSION_TIMEOUT_HOURS=2

# ---- Email (SMTP) ----
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
# Use an app-specific password, never your real account password.
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@campusplayer.com
ADMIN_EMAIL=admin@campusplayer.com

# ---- SMS - Google Messages Web (for parent alerts) ----
SMS_ENABLED=False
SMS_USE_SELENIUM=True

# ---- AI - Gemini API ----
# Get a key from https://aistudio.google.com/apikey - keep it secret.
GEMINI_API_KEY=

# ---- Feature Flags ----
ENABLE_2FA=True
ENABLE_REGISTRATION=True
ENABLE_MAINTENANCE_MODE=False

# ---- First-run admin account ----
# If unset, a random admin password is generated and printed to the
# server log on first startup. Set this explicitly for production.
ADMIN_PASSWORD=
